# Copy to .env in the repository root; never commit real credentials.
POSTGRES_USER=merts
POSTGRES_DB=merts
# Generate a password with openssl rand -hex 32; use the same value in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://merts:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/merts?sslmode=disable
# On migration, preserve the old SECRET_KEY (encrypted outbox) and JWT keys.
# For new secrets only: openssl rand -hex 32
SECRET_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
DEBUG=False
ALLOWED_HOSTS=166.0.28.165,localhost,127.0.0.1
# Add your HTTPS API domain to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
CSRF_TRUSTED_ORIGINS=https://YOUR_FRONTEND_DOMAIN,https://166.0.28.165
CORS_ALLOWED_ORIGINS=https://YOUR_FRONTEND_DOMAIN
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
TRUST_HTTPS_PROXY=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_COURSE_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
PLATFORM_OWNER_USER_ID=
PLATFORM_OWNER_ADMIN_ID=1
