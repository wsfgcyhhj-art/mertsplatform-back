# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/merts_db?schema=public"

# Server configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_ACCESS_SECRET="merts-jwt-access-secret-key"
JWT_REFRESH_SECRET="merts-jwt-refresh-secret-key"

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_BOT_USERNAME="MertsPlatform_bot"
